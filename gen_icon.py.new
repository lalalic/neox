"""Creative Neox app icon generator.

Concept: a glowing "Nexus orb" — vibrant gradient sphere on near-black with a
bold geometric "N" that doubles as an upward arrow (Neo = next).  Particle
sparkles around the orb evoke an agent network.

Run:  python3 gen_icon.py
Output: Neox/Assets.xcassets/AppIcon.appiconset/AppIcon.png  (1024x1024)
"""

from PIL import Image, ImageDraw, ImageFilter
import math
import os
import random

SIZE = 1024
OUT = "/Users/chengli/Workspace/free2/neox/Neox/Assets.xcassets/AppIcon.appiconset/AppIcon.png"


def lerp(a, b, t):
    return a + (b - a) * t


def lerp_color(c1, c2, t):
    return tuple(int(lerp(c1[i], c2[i], t)) for i in range(len(c1)))


def main():
    img = Image.new("RGBA", (SIZE, SIZE), (0, 0, 0, 255))
    draw = ImageDraw.Draw(img)

    # ----- Background: deep cosmic gradient (top → bottom) -----
    top    = (10, 8, 28)     # near-black indigo
    bottom = (28, 6, 40)     # plum
    for y in range(SIZE):
        t = y / SIZE
        draw.line([(0, y), (SIZE - 1, y)], fill=lerp_color(top, bottom, t))

    # Subtle starfield
    rng = random.Random(42)
    for _ in range(180):
        x = rng.randint(0, SIZE - 1)
        y = rng.randint(0, SIZE - 1)
        a = rng.randint(40, 160)
        s = rng.choice([1, 1, 1, 2])
        draw.ellipse([x, y, x + s, y + s], fill=(255, 255, 255, a))

    # ----- The Nexus orb: radial gradient sphere -----
    cx, cy = SIZE // 2, int(SIZE * 0.50)
    R = 360
    # Build orb on its own layer for shaping + glow
    orb = Image.new("RGBA", (SIZE, SIZE), (0, 0, 0, 0))
    odraw = ImageDraw.Draw(orb)

    # Outer halo
    for r in range(R + 220, R, -1):
        t = (r - R) / 220
        a = int(80 * (1 - t) ** 2)
        odraw.ellipse([cx - r, cy - r, cx + r, cy + r],
                      fill=(255, 80, 180, a))

    # Sphere body — magenta→orange gradient
    for r in range(R, 0, -1):
        t = r / R
        # Outer: hot pink, mid: orange, inner: pale yellow
        if t > 0.6:
            color = lerp_color((230, 30, 130), (255, 90, 80), (t - 0.6) / 0.4)
        elif t > 0.25:
            color = lerp_color((255, 180, 80), (230, 60, 110), (t - 0.25) / 0.35)
        else:
            color = lerp_color((255, 250, 220), (255, 180, 80), t / 0.25)
        odraw.ellipse([cx - r, cy - r, cx + r, cy + r], fill=color + (255,))

    # Highlight glint (top-left)
    glint = Image.new("RGBA", (SIZE, SIZE), (0, 0, 0, 0))
    gdraw = ImageDraw.Draw(glint)
    hx, hy = cx - 130, cy - 150
    for r in range(110, 0, -1):
        a = int(180 * (1 - r / 110) ** 2)
        gdraw.ellipse([hx - r, hy - r, hx + r, hy + r],
                      fill=(255, 255, 255, a))
    glint = glint.filter(ImageFilter.GaussianBlur(radius=18))
    orb = Image.alpha_composite(orb, glint)

    # Inner shadow (bottom-right) for 3D feel
    shadow = Image.new("RGBA", (SIZE, SIZE), (0, 0, 0, 0))
    sdraw = ImageDraw.Draw(shadow)
    sx, sy = cx + 70, cy + 90
    for r in range(220, 0, -1):
        a = int(110 * (1 - r / 220) ** 2)
        sdraw.ellipse([sx - r, sy - r, sx + r, sy + r],
                      fill=(60, 0, 30, a))
    shadow = shadow.filter(ImageFilter.GaussianBlur(radius=20))
    # Mask shadow to orb shape
    mask = Image.new("L", (SIZE, SIZE), 0)
    ImageDraw.Draw(mask).ellipse([cx - R, cy - R, cx + R, cy + R], fill=255)
    orb_with_shadow = Image.composite(shadow, orb, mask)
    orb = Image.alpha_composite(orb, orb_with_shadow)

    img = Image.alpha_composite(img, orb)
    draw = ImageDraw.Draw(img)

    # ----- Glyph: "N" that doubles as forward arrow -----
    # Two verticals + diagonal slash. Diagonal extends past top-right as arrow.
    glyph = Image.new("RGBA", (SIZE, SIZE), (0, 0, 0, 0))
    gdraw = ImageDraw.Draw(glyph)

    stroke_w = 70
    # Coordinates inside the orb
    x1 = cx - 170
    x2 = cx + 170
    y_top = cy - 200
    y_bot = cy + 200

    # Left vertical
    gdraw.rounded_rectangle(
        [x1 - stroke_w // 2, y_top, x1 + stroke_w // 2, y_bot],
        radius=stroke_w // 2,
        fill=(255, 255, 255, 240),
    )
    # Right vertical
    gdraw.rounded_rectangle(
        [x2 - stroke_w // 2, y_top, x2 + stroke_w // 2, y_bot],
        radius=stroke_w // 2,
        fill=(255, 255, 255, 240),
    )
    # Diagonal — bottom-left to top-right, extended into an arrow
    # Compute polygon for thick diagonal
    dx = (x2 + 60) - x1
    dy = (y_top - 70) - y_bot
    length = math.hypot(dx, dy)
    nx = -dy / length * (stroke_w / 2)
    ny = dx / length * (stroke_w / 2)
    poly = [
        (x1 + nx,        y_bot + ny),
        (x1 - nx,        y_bot - ny),
        (x2 + 60 - nx,   y_top - 70 - ny),
        (x2 + 60 + nx,   y_top - 70 + ny),
    ]
    gdraw.polygon(poly, fill=(255, 255, 255, 240))

    # Arrow head at top-right end of the diagonal
    ax, ay = x2 + 60, y_top - 70
    head = [
        (ax + 90, ay - 30),
        (ax - 35, ay - 110),
        (ax - 10, ay + 15),
    ]
    gdraw.polygon(head, fill=(255, 255, 255, 240))

    # Soft glow under glyph
    glyph_glow = glyph.filter(ImageFilter.GaussianBlur(radius=20))
    img = Image.alpha_composite(img, glyph_glow)
    img = Image.alpha_composite(img, glyph)
    draw = ImageDraw.Draw(img)

    # ----- Particle agents around orb -----
    rng = random.Random(7)
    particles = []
    for _ in range(14):
        ang = rng.uniform(0, math.tau)
        rad = rng.uniform(R + 60, R + 200)
        px = cx + math.cos(ang) * rad
        py = cy + math.sin(ang) * rad
        if 80 < px < SIZE - 80 and 80 < py < SIZE - 80:
            particles.append((px, py, rng.choice([5, 6, 7, 9])))

    for px, py, r in particles:
        # halo
        for gr in range(r * 6, 0, -1):
            a = int(120 * (1 - gr / (r * 6)) ** 2)
            draw.ellipse([px - gr, py - gr, px + gr, py + gr],
                         fill=(120, 220, 255, a))
        # core
        draw.ellipse([px - r, py - r, px + r, py + r],
                     fill=(220, 245, 255, 255))

    # Connecting threads — subtle network feel
    for i, (px, py, _) in enumerate(particles):
        if i + 1 < len(particles):
            (qx, qy, _) = particles[i + 1]
            draw.line([(px, py), (qx, qy)], fill=(120, 220, 255, 35), width=1)

    # ----- Save -----
    os.makedirs(os.path.dirname(OUT), exist_ok=True)
    img.convert("RGB").save(OUT, "PNG", optimize=True)
    print(f"Wrote {OUT} ({SIZE}x{SIZE})")


if __name__ == "__main__":
    main()
